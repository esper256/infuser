<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants Condition="'$(WebPlayer)' != 'true'">UNITY_EDITOR</DefineConstants>
    <DefineConstants Condition="'$(WebPlayer)' == 'true'">UNITY_WEBGL</DefineConstants>
    <NoWarn>0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../sdk/unity/Assets/Infuser/Runtime/*.cs" />
    <Compile Include="../../sdk/unity/Assets/Infuser/Editor/*.cs" />
    <Compile Include="Doubles.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
