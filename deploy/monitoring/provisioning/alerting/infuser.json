{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Infuser",
      "folder": "Infuser",
      "interval": "1m",
      "rules": [
        {
          "uid": "infuser-checks",
          "title": "Infuser dependency failed",
          "condition": "B",
          "for": "3m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "labels": {
            "service": "infuser",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Read the matching check and suggested action in Infuser operator tools.",
            "runbook_url": "https://github.com/esper256/infuser/blob/main/docs/monitoring-operations.md#responding-to-an-alert"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "infuser-prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "1 - infuser_check_success",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "infuser-collector",
          "title": "Infuser health collector stopped",
          "condition": "B",
          "for": "2m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "labels": {
            "service": "infuser",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Inspect infuser-health.timer and infuser-health.service.",
            "runbook_url": "https://github.com/esper256/infuser/blob/main/docs/monitoring-operations.md#responding-to-an-alert"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "infuser-prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "(time() - infuser_collector_timestamp_seconds > bool 180) or absent(infuser_collector_timestamp_seconds)",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "infuser-scrape",
          "title": "Monitoring target unavailable",
          "condition": "B",
          "for": "2m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "labels": {
            "service": "infuser",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Inspect the affected monitoring service.",
            "runbook_url": "https://github.com/esper256/infuser/blob/main/docs/monitoring-operations.md#responding-to-an-alert"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "infuser-prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "1 - up",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "infuser-website",
          "title": "Website unavailable",
          "condition": "B",
          "for": "3m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "labels": {
            "service": "infuser",
            "severity": "critical"
          },
          "annotations": {
            "summary": "Check DNS, Caddy and the controller. A missing website target also triggers this alert.",
            "runbook_url": "https://github.com/esper256/infuser/blob/main/docs/monitoring-operations.md#responding-to-an-alert"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "infuser-prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "1 - probe_success",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "infuser-certificate",
          "title": "HTTPS certificate expires soon",
          "condition": "B",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Alerting",
          "labels": {
            "service": "infuser",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Inspect Caddy certificate renewal and DNS-provider access.",
            "runbook_url": "https://github.com/esper256/infuser/blob/main/docs/monitoring-operations.md#responding-to-an-alert"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "infuser-prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "probe_ssl_earliest_cert_expiry - time() < bool 14 * 86400",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "infuser-memory",
          "title": "Host memory pressure",
          "condition": "B",
          "for": "10m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "labels": {
            "service": "infuser",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Review game and service memory use.",
            "runbook_url": "https://github.com/esper256/infuser/blob/main/docs/monitoring-operations.md#responding-to-an-alert"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "infuser-prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes > bool 0.9",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "infuser-disk",
          "title": "Host filesystem nearly full",
          "condition": "B",
          "for": "5m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "labels": {
            "service": "infuser",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Review storage categories; do not prune game saves or worlds.",
            "runbook_url": "https://github.com/esper256/infuser/blob/main/docs/monitoring-operations.md#responding-to-an-alert"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "infuser-prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "max((node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|fuse.*\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|fuse.*\"} < bool 0.1) and (node_filesystem_readonly == 0))",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "infuser-maintenance",
          "title": "Backup staging is taking too long",
          "condition": "B",
          "for": "10m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "labels": {
            "service": "infuser",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Inspect backup service and staging disk space; its stop hook must resume Infuser.",
            "runbook_url": "https://github.com/esper256/infuser/blob/main/docs/monitoring-operations.md#responding-to-an-alert"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "infuser-prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "infuser_maintenance",
                "instant": true,
                "range": false,
                "intervalMs": 30000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "type": "query"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
