{
  "uid": "infuser-host",
  "title": "Infuser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "infuser"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Health checks",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "infuser-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "infuser_check_success{job=\"host\",project=\"infuser\"}",
          "legendFormat": "{{check}}{{category}}{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "boolean"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Health check age",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "infuser-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - infuser_collector_timestamp_seconds{job=\"host\",project=\"infuser\"}",
          "legendFormat": "{{check}}{{category}}{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Available disk",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "infuser-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "infuser_disk_available_bytes{job=\"host\",project=\"infuser\"}",
          "legendFormat": "{{check}}{{category}}{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Infuser storage",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "infuser-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "infuser_storage_bytes{job=\"host\",project=\"infuser\"}",
          "legendFormat": "{{check}}{{category}}{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Last verified backup age",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "infuser-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - infuser_backup_verified_timestamp_seconds{job=\"host\",project=\"infuser\"}) and (infuser_backup_verified_timestamp_seconds{job=\"host\",project=\"infuser\"} > 0)",
          "legendFormat": "{{check}}{{category}}{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Website response time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "infuser-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{project=\"infuser\"}",
          "legendFormat": "{{check}}{{category}}{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
