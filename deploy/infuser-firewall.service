[Unit]
Description=Infuser game-port admission firewall
Before=docker.service infuser.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/infuser-firewall-load
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
